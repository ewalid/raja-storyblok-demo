STORYBLOK_TOKEN=YOUR_STORYBLOK_TOKEN

VITE_VWO_ACCOUNT_ID=YOUR_VWO_ACCOUNT_ID
VITE_VWO_SDK_KEY=YOUR_VWO_SDK_KEY

# Shopify Storefront API (client-side, public) — powers the /products pages and
# the shopify-demo-product-picker blocks.
SHOPIFY_DOMAIN=your-shopify-domain.myshopify.com
SHOPIFY_TOKEN=YOUR_SHOPIFY_STOREFRONT_TOKEN

# Akeneo Connection (server-only): used to proxy authenticated media downloads at GET /api/akeneo/media
AKENEO_BASE_URL=https://your-instance.cloud.akeneo.com
AKENEO_CLIENT_ID=
AKENEO_CLIENT_SECRET=
AKENEO_USERNAME=
AKENEO_PASSWORD=
